FROM heartcodec-dev:20261101
USER root
RUN /opt/sa3-venv/bin/python -m ensurepip \
    && /opt/sa3-venv/bin/python -m pip install --no-cache-dir \
       'torch==2.7.1' 'numpy==2.0.2' 'transformers==4.57.6' 'tokenizers==0.22.1' \
       'accelerate==1.12.0' 'torchtune==0.4.0' 'torchao==0.9.0' \
       'vector-quantize-pytorch==1.27.15' 'einops==0.8.1' 'tqdm==4.67.1' \
       'soundfile==0.13.1' 'mido==1.3.3'
WORKDIR /workspace
ENTRYPOINT []
